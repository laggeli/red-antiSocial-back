    {
      "name": "0. Crear Usuario de prueba para asociar a los posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que necesito un usuario para asociar los posts, cuando hago el POST, responde 201 (Created)\", function () {",
              "    pm.response.to.have.status(201);",
              "    const res = pm.response.json();",
              "    ",
              "    const nick = (res.user && res.user.nickName) || res.nickName;",
              "    pm.collectionVariables.set(\"NICKNAME_ACTUAL\", nick);",
              "    ",
              "    let userId = (res.user && (res.user._id || res.user.id)) || res._id || res.id;",
              "    if (userId) {",
              "        pm.collectionVariables.set(\"USER_ID_ACTUAL\", String(userId));",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/users",
          "host": ["{{BASE_URL}}"],
          "path": ["users"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickName\": \"post_author_{{$randomInt}}\",\n  \"nombre\": \"Creador De Posts\",\n  \"email\": \"author_{{$randomInt}}@test.com\",\n  \"contraseña\": \"123456\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "0.1 Obtener ID real del usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Verificar y obtener ObjectId del usuario recién creado\", function () {",
              "    pm.response.to.have.status(200);",
              "    const res = pm.response.json();",
              "    const userObj = Array.isArray(res) ? res.find(u => u.nickName === pm.collectionVariables.get(\"NICKNAME_ACTUAL\")) : res;",
              "    ",
              "    if (userObj && (userObj._id || userObj.id)) {",
              "        const realId = String(userObj._id || userObj.id);",
              "        pm.collectionVariables.set(\"USER_ID_ACTUAL\", realId);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
