      "name": "POST/Posts (createPost - Con URLs de Imagen)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let userId = pm.collectionVariables.get(\"USER_ID_ACTUAL\");",
              "if (!userId || userId.length !== 24) {",
              "    userId = '507f1f77bcf86cd799439011';",
              "}",
              "pm.variables.set(\"TARGET_USER_ID\", userId);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que hago un POST a /posts con URLs, cuando se crea la publicación, responde 201 (Created)\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Validar mensaje de exito en POST: 'Publicación creada exitosamente'\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"mensaje\");",
              "    pm.expect(res.mensaje).to.equal(\"Publicación creada exitosamente\");",
              "});",
              "",
              "pm.test(\"Dado que se crea el post, contiene los datos populados y subdocumentos de imágenes\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"post\");",
              "    pm.expect(res.post).to.have.property(\"_id\");",
              "    pm.expect(res.post.descripcion).to.equal(\"Publicación de prueba con URLs externas\");",
              "    ",
              "    pm.collectionVariables.set(\"POST_ID_ACTUAL\", res.post._id);",
              "    if (res.post.imagenes && res.post.imagenes.length > 0) {",
              "        pm.collectionVariables.set(\"IMAGE_ID_ACTUAL\", res.post.imagenes[0]._id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
