            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que envío eliminarImagenId en el PATCH, responde 200 (OK)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Validar mensaje de exito al borrar imagen en PATCH: 'Publicación modificada exitosamente'\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"mensaje\");",
              "    pm.expect(res.mensaje).to.equal(\"Publicación modificada exitosamente\");",
              "});",
              "",
              "pm.test(\"Dado que envío eliminarImagenId en el PATCH, la imagen ya no existe en el array\", function () {",
              "    const res = pm.response.json();",
              "    const imagenBorradaId = pm.variables.get(\"TARGET_IMAGE_ID\");",
              "    if (imagenBorradaId) {",
              "        const existe = res.post.imagenes.some(img => img._id === imagenBorradaId);",
              "        pm.expect(existe).to.be.false;",
              "    }",
              "    pm.collectionVariables.unset(\"IMAGE_ID_ACTUAL\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
