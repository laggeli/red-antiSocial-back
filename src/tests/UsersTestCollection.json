  "item": [
    {
      "name": "GET/Users (getUsers)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que hago un GET a /users, cuando el servidor responde, entonces el código de estado debe ser 200 (OK)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Dado que obtengo la lista de usuarios, cuando recibo la respuesta, entonces el cuerpo debe ser un array de usuarios\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Dado que recibo usuarios, cuando analizo cada objeto, entonces debe tener los campos nickName, nombre y email\", function () {",
              "    const users = pm.response.json();",
              "    users.forEach(user => {",
              "        pm.expect(user).to.have.property(\"nickName\");",
              "        pm.expect(user).to.have.property(\"nombre\");",
              "        pm.expect(user).to.have.property(\"email\");",
              "    });",
              "});",
              "",
              "pm.test(\"Dado que cada usuario tiene un email, cuando verifico su contenido, entonces debe tener un formato válido de correo electrónico\", function () {",
              "    const users = pm.response.json();",
              "    users.forEach(user => {",
              "        pm.expect(user.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/users",
          "host": ["{{BASE_URL}}"],
          "path": ["users"]
        }
      },
      "response": []
    },
    {
      "name": "POST/Users (createUser)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que hago un POST a /users, cuando creo un usuario válido, entonces el código de estado debe ser 201 (Created)\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Dado que creo un usuario, cuando recibo la respuesta, entonces debe contener los campos nickName, nombre y email\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"user\");",
              "    pm.expect(res.user).to.have.property(\"nickName\");",
              "    pm.expect(res.user).to.have.property(\"nombre\");",
              "    pm.expect(res.user).to.have.property(\"email\");",
              "    ",
              "    // Guardado del nickName dinámico en la colección",
              "    pm.collectionVariables.set(\"CURRENT_USER_NICKNAME\", res.user.nickName);",
              "});",
              "",
              "pm.test(\"Dado que el usuario tiene email, cuando verifico su contenido, entonces debe tener formato válido\", function () {",
              "    const res = pm.response.json();",
              "    if (res && res.user) {",
              "        pm.expect(res.user.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/users",
          "host": ["{{BASE_URL}}"],
          "path": ["users"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickName\": \"prueba_nueva_{{$randomInt}}\",\n  \"nombre\": \"Susana Chavez\",\n  \"email\": \"prueba_nueva_{{$randomInt}}@test.com\",\n  \"contraseña\": \"123456\"\n}",
          "options": {
