    {
      "name": "GET/Users (Verificar los 5 usuarios creados)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Dado que solicito la lista de usuarios, cuando el servidor responde, entonces el código de estado debe ser 200 (OK)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const usuarios = pm.response.json();",
              "const nickNamesCreados = JSON.parse(pm.collectionVariables.get('NICKNAMES_CREADOS'));",
              "",
              "pm.test(`Dado que obtuve la lista completa de usuarios, cuando analizo la base de datos, entonces se encuentran presentes los ${nickNamesCreados.length} usuarios creados: [${nickNamesCreados.join(', ')}]`, function () {",
              "    pm.expect(nickNamesCreados.length).to.equal(5);",
              "    ",
              "    nickNamesCreados.forEach(nick => {",
              "        const existe = usuarios.some(user => user && user.nickName === nick);",
              "        pm.expect(existe, `El usuario ${nick} no fue encontrado en la base de datos`).to.be.true;",
              "    });",
              "});",
              "",
              "pm.collectionVariables.unset('NICKNAMES_CREADOS');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/users",
