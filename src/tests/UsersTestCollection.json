          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado un usuario, cuando hago un GET /users/:nickName, entonces devuelve los datos del usuario y responde 200 (OK)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"La respuesta contiene los datos del usuario\", function () {",
              "    const user = pm.response.json();",
              "    const nickNameEsperado = pm.collectionVariables.get(\"CURRENT_USER_NICKNAME\");",
              "    pm.expect(user.nickName).to.equal(nickNameEsperado);",
              "    pm.expect(user).to.have.property(\"nombre\");",
              "    pm.expect(user).to.have.property(\"email\");",
              "});",

              "pm.test(\"El GET no debe devolver la contraseña\", function () {",
              "    const user = pm.response.json();",
              "    pm.expect(user).to.not.have.property(\"contraseña\");",
              "});"
