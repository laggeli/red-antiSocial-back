    {
      "name": "POST/Users (Crear 5 Usuarios)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('USUARIOS_CREADOS')) {",
              "    pm.collectionVariables.set('USUARIOS_CREADOS', '1');",
              "    pm.collectionVariables.set('NICKNAMES_CREADOS', JSON.stringify([]));",
              "}",
              "",
              "const contador = parseInt(pm.collectionVariables.get('USUARIOS_CREADOS'));",
              "const randomId = Math.floor(Math.random() * 10000);",
              "const nickName = `user_test_${contador}_${randomId}`;",
              "",
              "pm.variables.set('TEMP_NICKNAME', nickName);",
              "pm.variables.set('TEMP_EMAIL', `${nickName}@test.com`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const contadorActual = pm.collectionVariables.get('USUARIOS_CREADOS');",
              "",
              "pm.test(`Dado que envío una solicitud para crear el usuario #${contadorActual} de 5, cuando el servidor procesa los datos, entonces responde con 201 (Created)`, function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(`Dado que se procesa cada usuario del lote, cuando reviso la respuesta, contiene la propiedad 'user' con su nickName`, function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property('user');",
              "    pm.expect(res.user).to.have.property('nickName');",
              "    ",
              "    let listaNickNames = JSON.parse(pm.collectionVariables.get('NICKNAMES_CREADOS'));",
              "    listaNickNames.push(res.user.nickName);",
              "    pm.collectionVariables.set('NICKNAMES_CREADOS', JSON.stringify(listaNickNames));",
              "});",
              "",
              "let numeroContador = parseInt(contadorActual);",
              "if (numeroContador < 5) {",
              "    pm.collectionVariables.set('USUARIOS_CREADOS', (numeroContador + 1).toString());",
              "    pm.execution.setNextRequest('POST/Users (Crear 5 Usuarios)');",
              "} else {",
              "    const listaFinal = JSON.parse(pm.collectionVariables.get('NICKNAMES_CREADOS'));",
              "pm.test(`Dado que finalizó el proceso en lote, cuando verifico la cantidad total, entonces se crearon ${listaFinal.length} usuarios: usuarios -> [${listaFinal.join(', ')}]`, function () {",
              "    pm.expect(listaFinal.length).to.equal(5);",
              "});",
              "    pm.collectionVariables.unset('USUARIOS_CREADOS');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/users",
