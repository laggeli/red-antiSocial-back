          "mode": "raw",
          "raw": "{\n  \"nickName\": \"{{TEMP_NICKNAME}}\",\n  \"nombre\": \"Usuario De Prueba\",\n  \"email\": \"{{TEMP_EMAIL}}\",\n  \"contraseña\": \"123456\"\n}"
        }
