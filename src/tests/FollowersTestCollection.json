    "name": "FollowersTestCollection",
    "description": "Pruebas integrales de EndPoints de Seguidores (Followers/Following) con creación autónoma de usuarios para MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
