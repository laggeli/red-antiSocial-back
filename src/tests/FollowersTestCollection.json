              "    pm.collectionVariables.set(\"NICKNAME_SEGUIDO\", nick);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/users",
          "host": ["{{BASE_URL}}"],
          "path": ["users"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickName\": \"followed_user_{{$randomInt}}\",\n  \"nombre\": \"Usuario Seguido\",\n  \"email\": \"followed_{{$randomInt}}@test.com\",\n  \"contraseña\": \"123456\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "POST/Users/:nickName/following/:followedNickName (followUser - Error Auto Seguimiento)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const nick = pm.collectionVariables.get(\"NICKNAME_SEGUIDOR\");",
              "pm.variables.set(\"TARGET_SEGUIDOR\", nick);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que un usuario intenta seguirse a sí mismo, responde 400 (Bad Request)\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Retorna un mensaje explicativo de error de auto-seguimiento\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.satisfy(res => res.hasOwnProperty('error') || res.hasOwnProperty('message'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/users/{{TARGET_SEGUIDOR}}/following/{{TARGET_SEGUIDOR}}",
          "host": ["{{BASE_URL}}"],
          "path": ["users", "{{TARGET_SEGUIDOR}}", "following", "{{TARGET_SEGUIDOR}}"]
        }
      },
      "response": []
    },
    {
      "name": "POST/Users/:nickName/following/:followedNickName (followUser)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const seguidor = pm.collectionVariables.get(\"NICKNAME_SEGUIDOR\");",
              "const seguido = pm.collectionVariables.get(\"NICKNAME_SEGUIDO\");",
              "pm.variables.set(\"TARGET_SEGUIDOR\", seguidor);",
              "pm.variables.set(\"TARGET_SEGUIDO\", seguido);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que hago un POST a /users/:nickName/following/:followedNickName, responde 201 (Created)\", function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Devuelve el mensaje de confirmación de seguimiento\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.satisfy(r => r.hasOwnProperty('message') || r.hasOwnProperty('mensaje'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/users/{{TARGET_SEGUIDOR}}/following/{{TARGET_SEGUIDO}}",
          "host": ["{{BASE_URL}}"],
          "path": ["users", "{{TARGET_SEGUIDOR}}", "following", "{{TARGET_SEGUIDO}}"]
        }
      },
      "response": []
    },
    {
      "name": "GET/Users/:nickName/followers (getFollowers)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const seguidor = pm.collectionVariables.get(\"NICKNAME_SEGUIDOR\");",
              "const seguido = pm.collectionVariables.get(\"NICKNAME_SEGUIDO\");",
              "pm.variables.set(\"TARGET_SEGUIDOR\", seguidor);",
              "pm.variables.set(\"TARGET_SEGUIDO\", seguido);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que consulto /followers del usuario seguido, responde 200 (OK)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Responde con un array que contiene al usuario seguidor\", function () {",
              "    const followers = pm.response.json();",
              "    pm.expect(followers).to.be.an(\"array\");",
              "    const seguidorEsperado = pm.variables.get(\"TARGET_SEGUIDOR\");",
              "    const existe = followers.some(u => u && (u.nickName === seguidorEsperado || u === seguidorEsperado));",
              "    pm.expect(existe).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/users/{{TARGET_SEGUIDO}}/followers",
          "host": ["{{BASE_URL}}"],
          "path": ["users", "{{TARGET_SEGUIDO}}", "followers"]
