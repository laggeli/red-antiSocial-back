  "item": [
    {
      "name": "0. Setup - Crear Usuario Seguidor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Dado que necesito un primer usuario (seguidor), se crea con 201 (Created)\", function () {",
              "    pm.response.to.have.status(201);",
              "    const res = pm.response.json();",
              "    const nick = (res.user && res.user.nickName) || res.nickName;",
              "    pm.collectionVariables.set(\"NICKNAME_SEGUIDOR\", nick);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/users",
          "host": ["{{BASE_URL}}"],
          "path": ["users"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickName\": \"follower_user_{{$randomInt}}\",\n  \"nombre\": \"Usuario Seguidor\",\n  \"email\": \"follower_{{$randomInt}}@test.com\",\n  \"contraseña\": \"123456\"\n}"
        }
      },
      "response": []
    },
    {
